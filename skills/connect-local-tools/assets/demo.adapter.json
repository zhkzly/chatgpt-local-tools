{
  "version": 1,
  "name": "local-demo",
  "tools": [
    {
      "name": "echo_text",
      "description": "Return the provided text literally using a fixed local Python command.",
      "kind": "cli",
      "read_only": true,
      "command": [
        "python3",
        "-c",
        "import sys; print(sys.argv[1])",
        "{text}"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "timeout_seconds": 45,
      "max_output_bytes": 262144
    }
  ]
}
